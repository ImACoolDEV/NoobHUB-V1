-- Target and Anchor Logic
local function findBossRoot()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and string.lower(obj.Name) == string.lower(TARGET_NAME) then
            local targetPart = obj:FindFirstChild("Head") or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("UpperTorso") or obj:FindFirstChild("Torso") or obj.PrimaryPart
            if targetPart then return obj, targetPart end
        end
    end
    return nil, nil
end

local function applyImmuneHeadAnchor(targetModel, targetRoot)
    local character = localPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetRoot then return end

    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end

    for _, descendant in ipairs(targetModel:GetDescendants()) do
        if descendant:IsA("TouchTransmitter") or descendant.Name == "TouchInterest" then
            descendant:Destroy()
        end
    end

    local headPart = targetModel:FindFirstChild("Head") or targetRoot
    hrp.CFrame = CFrame.new(headPart.Position + Vector3.new(0, 5, 0), headPart.Position)
end

-- Weapon Handling
local function getBestWeapon()
    local character = localPlayer.Character
    local backpack = localPlayer:FindFirstChild("Backpack")
    if not character or not backpack then return nil end

    for _, targetName in ipairs(WEAPON_PRIORITY) do
        local targetLower = string.lower(targetName)

        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Tool") and string.find(string.lower(child.Name), targetLower, 1, true) then
                return child
            end
        end

        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") and string.find(string.lower(child.Name), targetLower, 1, true) then
                return child
            end
        end
    end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then return tool end
    end

    return nil
end

local function equipAndAttack()
    local character = localPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local bestTool = getBestWeapon()

    if humanoid and bestTool then
        if bestTool.Parent ~= character then
            humanoid:EquipTool(bestTool)
        end
        bestTool:Activate()

        local remote = bestTool:FindFirstChildOfClass("RemoteEvent") or bestTool:FindFirstChildOfClass("BindableEvent")
        if remote and remote:IsA("RemoteEvent") then
            remote:FireServer()
        end
    end
end

