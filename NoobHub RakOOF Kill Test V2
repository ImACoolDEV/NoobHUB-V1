// ============================================================================
// ADVANCED YELLOW OUTLINE & DROPS AUTO PICKUP LOGIC
// ============================================================================
function isInsidePlayerInventory(item: Instance): boolean {
	let ancestor: Instance | undefined = item.Parent;
	while (ancestor && ancestor !== Workspace) {
		if (Players.GetPlayerFromCharacter(ancestor) || ancestor.IsA("Backpack") || ancestor.Name === "Backpack") {
			return true;
		}
		ancestor = ancestor.Parent;
	}
	return false;
}

function isYellowColor(color?: Color3): boolean {
	if (!color) return false;
	return color.R > 0.6 && color.G > 0.6 && color.B < 0.4;
}

function hasYellowOutline(obj: Instance): boolean {
	for (const child of obj.GetDescendants()) {
		if (child.IsA("Highlight")) {
			if (isYellowColor(child.OutlineColor) || isYellowColor(child.FillColor)) {
				return true;
			}
		} else if (child.IsA("SelectionBox")) {
			if (isYellowColor(child.Color3)) {
				return true;
			}
		} else if (child.IsA("UIStroke")) {
			if (isYellowColor(child.Color)) {
				return true;
			}
		}
	}
	return false;
}

function getPartFromItem(item: Instance): BasePart | undefined {
	if (item.IsA("BasePart")) {
		return item;
	} else if (item.IsA("Model")) {
		return item.PrimaryPart || (item.FindFirstChildWhichIsA("BasePart") as BasePart);
	} else {
		return item.FindFirstChildWhichIsA("BasePart") as BasePart;
	}
}

function getPickableItems(): Instance[] {
	const items: Instance[] = [];
	const dropsFolder = Workspace.FindFirstChild("Drops") || Workspace.FindFirstChild("drops");
	const searchContainer = dropsFolder ? dropsFolder.GetDescendants() : Workspace.GetDescendants();

	for (const obj of searchContainer) {
		if (!isInsidePlayerInventory(obj)) {
			if (hasYellowOutline(obj)) {
				items.push(obj);
			} else {
				for (const targetName of TARGET_ITEMS) {
					if (obj.Name.find(targetName)[0] !== undefined) {
						items.push(obj);
						break;
					}
				}
			}
		}
	}
	return items;
}

