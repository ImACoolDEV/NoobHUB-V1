// ============================================================================
// CORE IMMUNE HEAD-ANCHOR LOGIC
// ============================================================================
function findBossRoot(): [Model?, BasePart?] {
	for (const obj of Workspace.GetDescendants()) {
		if (obj.IsA("Model") && obj.Name.lower() === TARGET_NAME.lower()) {
			const targetPart =
				(obj.FindFirstChild("Head") as BasePart) ||
				(obj.FindFirstChild("HumanoidRootPart") as BasePart) ||
				(obj.FindFirstChild("UpperTorso") as BasePart) ||
				(obj.FindFirstChild("Torso") as BasePart) ||
				obj.PrimaryPart;

			if (targetPart) {
				return [obj, targetPart];
			}
		}
	}
	return [undefined, undefined];
}

function applyImmuneHeadAnchor(targetModel: Model, targetRoot: BasePart): void {
	const character = localPlayer.Character;
	if (!character) return;
	const hrp = character.FindFirstChild("HumanoidRootPart") as BasePart;
	if (!hrp || !targetRoot) return;

	for (const part of character.GetChildren()) {
		if (part.IsA("BasePart")) {
			part.CanCollide = false;
		}
	}

	for (const descendant of targetModel.GetDescendants()) {
		if (descendant.IsA("TouchTransmitter") || descendant.Name === "TouchInterest") {
			descendant.Destroy();
		}
	}

	const headPart = (targetModel.FindFirstChild("Head") as BasePart) || targetRoot;
	const absoluteTopPosition = headPart.Position.add(new Vector3(0, 5, 0));
	hrp.CFrame = new CFrame(absoluteTopPosition, headPart.Position);
}

