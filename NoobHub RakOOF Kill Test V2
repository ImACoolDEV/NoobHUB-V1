    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") then
            character.HumanoidRootPart.CFrame = obj.CFrame + Vector3.new(0, 3.5, 0)
            break
        end
    end
end)

--------------------------------------------------------------------------------
-- ADVANCED YELLOW OUTLINE & DROPS AUTO PICKUP LOGIC
--------------------------------------------------------------------------------
local function isInsidePlayerInventory(item)
    local ancestor = item.Parent
    while ancestor and ancestor ~= Workspace do
        if Players:GetPlayerFromCharacter(ancestor) or ancestor:IsA("Backpack") or ancestor.Name == "Backpack" then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end

local function isYellowColor(color)
    if not color then return false end
    return (color.R > 0.6 and color.G > 0.6 and color.B < 0.4)
end

local function hasYellowOutline(obj)
    for _, child in ipairs(obj:GetDescendants()) do
        if child:IsA("Highlight") then
            if isYellowColor(child.OutlineColor) or isYellowColor(child.FillColor) then
                return true
            end
        elseif child:IsA("SelectionBox") then
            if isYellowColor(child.Color3) then
                return true
            end
        elseif child:IsA("UIStroke") then
            if isYellowColor(child.Color) then
                return true
            end
        end
    end
    return false
end

local function getPartFromItem(item)
    if item:IsA("BasePart") then
        return item
    elseif item:IsA("Model") then
        return item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
    else
        return item:FindFirstChildWhichIsA("BasePart")
    end
end

local function getPickableItems()
    local items = {}
    local dropsFolder = Workspace:FindFirstChild("Drops") or Workspace:FindFirstChild("drops")
    local searchContainer = dropsFolder and dropsFolder:GetDescendants() or Workspace:GetDescendants()
    
    for _, obj in ipairs(searchContainer) do
        if not isInsidePlayerInventory(obj) then
            if hasYellowOutline(obj) then
                table.insert(items, obj)
            else
                for _, targetName in ipairs(TARGET_ITEMS) do
                    if string.find(obj.Name, targetName) then
                        table.insert(items, obj)
                        break
                    end
                end
            end
        end
    end
    return items
end

