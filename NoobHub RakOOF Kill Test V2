function getBestWeapon(): Tool | undefined {
	const character = localPlayer.Character;
	const backpack = localPlayer.FindFirstChild("Backpack");
	if (!character || !backpack) return undefined;

	for (const targetName of WEAPON_PRIORITY) {
		const targetLower = targetName.lower();

		for (const child of character.GetChildren()) {
			if (child.IsA("Tool") && child.Name.lower().find(targetLower)[0] !== undefined) {
				return child;
			}
		}

		for (const child of backpack.GetChildren()) {
			if (child.IsA("Tool") && child.Name.lower().find(targetLower)[0] !== undefined) {
				return child;
			}
		}
	}

	for (const tool of backpack.GetChildren()) {
		if (tool.IsA("Tool")) return tool;
	}

	return undefined;
}

function equipAndAttack(): void {
	const character = localPlayer.Character;
	if (!character) return;
	const humanoid = character.FindFirstChildOfClass("Humanoid") as Humanoid;
	const bestTool = getBestWeapon();

	if (humanoid && bestTool) {
		if (bestTool.Parent !== character) {
			humanoid.EquipTool(bestTool);
		}
		bestTool.Activate();

		const remote =
			(bestTool.FindFirstChildOfClass("RemoteEvent") as RemoteEvent) ||
			(bestTool.FindFirstChildOfClass("BindableEvent") as BindableEvent);
		if (remote && remote.IsA("RemoteEvent")) {
			remote.FireServer();
		}
	}
}

