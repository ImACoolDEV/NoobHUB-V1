fogBtn.MouseButton1Click.Connect(() => {
	noFogActive = !noFogActive;
	fogBtn.Text = noFogActive ? "💡 Fullbright: ON" : "💡 Fullbright: OFF";
	fogGrad.Color = noFogActive
		? new ColorSequence(Color3.fromRGB(20, 120, 70), Color3.fromRGB(10, 70, 40))
		: new ColorSequence(Color3.fromRGB(32, 32, 38), Color3.fromRGB(18, 18, 22));
	fogStroke.Color = noFogActive ? Color3.fromRGB(50, 255, 150) : Color3.fromRGB(200, 160, 60);

	Lighting.FogEnd = noFogActive ? 9e9 : defaultFog;
	Lighting.Brightness = noFogActive ? 2 : 1;
});
