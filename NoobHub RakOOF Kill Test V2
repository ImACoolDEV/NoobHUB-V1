function findLocationPart(targetName: string): Instance | undefined {
	const miscFolder = Workspace.FindFirstChild("Misc");
	if (miscFolder) {
		const rakoofSpawns = miscFolder.FindFirstChild("RakoofSpawns");
		if (rakoofSpawns && rakoofSpawns.FindFirstChild(targetName)) {
			return rakoofSpawns.FindFirstChild(targetName);
		}
	}

	const locFolder = Workspace.FindFirstChild("LocationsIndicator");
	if (locFolder) {
		const targetAltName = targetName === "CaveA" ? "Cave1" : targetName === "CaveB" ? "Cave2" : targetName;
		if (locFolder.FindFirstChild(targetAltName)) return locFolder.FindFirstChild(targetAltName);
		if (locFolder.FindFirstChild(targetName)) return locFolder.FindFirstChild(targetName);
	}

	for (const obj of Workspace.GetDescendants()) {
		if (obj.Name === targetName) return obj;
	}
	return undefined;
}

function teleportToLocation(targetName: string): void {
	const character = localPlayer.Character;
	if (!character || !character.FindFirstChild("HumanoidRootPart")) return;

	const targetObj = findLocationPart(targetName);
	if (targetObj) {
		const targetPart = targetObj.IsA("BasePart")
			? targetObj
			: targetObj.IsA("Model")
			? targetObj.PrimaryPart || (targetObj.FindFirstChildWhichIsA("BasePart") as BasePart)
			: undefined;

		if (targetPart) {
			(character.FindFirstChild("HumanoidRootPart") as BasePart).CFrame = targetPart.CFrame.add(new Vector3(0, 3, 0));
		}
	}
}

