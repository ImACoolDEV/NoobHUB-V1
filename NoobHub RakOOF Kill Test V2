-- Button Helper
local function createButton(text, order)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 218, 0, 44)
    btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 12
    btn.LayoutOrder = order
    btn.Parent = scrollingContainer

    local btnGradient = Instance.new("UIGradient")
    btnGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(32, 32, 38)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(18, 18, 22))
    })
    btnGradient.Parent = btn

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.2
    stroke.Color = Color3.fromRGB(200, 160, 60)
    stroke.Transparency = 0.4
    stroke.Parent = btn

    btn.MouseEnter:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.2), { Transparency = 0, Color = Color3.fromRGB(255, 215, 0) }):Play()
    end)

    btn.MouseLeave:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.2), { Transparency = 0.4, Color = Color3.fromRGB(200, 160, 60) }):Play()
    end)

    return btn, btnGradient, stroke
end

