function createButton(text: string, order: number): [TextButton, UIGradient, UIStroke] {
	const btn = new Instance("TextButton");
	btn.Size = new UDim2(0, 218, 0, 44);
	btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255);
	btn.Text = text;
	btn.TextColor3 = Color3.fromRGB(240, 240, 240);
	btn.Font = Enum.Font.GothamSemibold;
	btn.TextSize = 12;
	btn.LayoutOrder = order;
	btn.Parent = scrollingContainer;

	const btnGradient = new Instance("UIGradient");
	btnGradient.Color = new ColorSequence([
		new ColorSequenceKeypoint(0, Color3.fromRGB(32, 32, 38)),
		new ColorSequenceKeypoint(1, Color3.fromRGB(18, 18, 22)),
	]);
	btnGradient.Parent = btn;

	const corner = new Instance("UICorner");
	corner.CornerRadius = new UDim(0, 10);
	corner.Parent = btn;

	const stroke = new Instance("UIStroke");
	stroke.Thickness = 1.2;
	stroke.Color = Color3.fromRGB(200, 160, 60);
	stroke.Transparency = 0.4;
	stroke.Parent = btn;

	btn.MouseEnter.Connect(() => {
		TweenService.Create(stroke, new TweenInfo(0.2), { Transparency: 0, Color: Color3.fromRGB(255, 215, 0) }).Play();
	});

	btn.MouseLeave.Connect(() => {
		TweenService.Create(stroke, new TweenInfo(0.2), { Transparency: 0.4, Color: Color3.fromRGB(200, 160, 60) }).Play();
	});

	return [btn, btnGradient, stroke];
}

