local function getBestWeapon()
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not character or not backpack then return nil end

    -- Iterate through weapon priorities from top to bottom
    for _, targetName in ipairs(WEAPON_PRIORITY) do
        local targetLower = string.lower(targetName)
        
        -- 1. Check currently equipped tools first
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Tool") and string.find(string.lower(child.Name), targetLower) then
                return child
            end
        end
        
        -- 2. Check Backpack
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") and string.find(string.lower(child.Name), targetLower) then
                return child
            end
        end
    end
    
    -- Fallback: return any available tool in Backpack if no priority match is found
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then return tool end
    end

    return nil
end

local function equipAndAttack()
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local bestTool = getBestWeapon()
    
    if humanoid and bestTool then
        if bestTool.Parent ~= character then
            humanoid:EquipTool(bestTool)
        end
        bestTool:Activate()

        local remote = bestTool:FindFirstChildOfClass("RemoteEvent") 
            or bestTool:FindFirstChildOfClass("BindableEvent")
        if remote then
            remote:FireServer()
        end
    end
end

