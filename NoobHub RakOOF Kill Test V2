--------------------------------------------------------------------------------
-- CORE IMMUNE HEAD-ANCHOR LOGIC
--------------------------------------------------------------------------------
local function findBossRoot()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name == TARGET_NAME or string.lower(obj.Name) == string.lower(TARGET_NAME)) then
            local targetPart = obj:FindFirstChild("Head")
                or obj:FindFirstChild("HumanoidRootPart") 
                or obj:FindFirstChild("UpperTorso") 
                or obj:FindFirstChild("Torso") 
                or obj.PrimaryPart
            
            if targetPart then
                return obj, targetPart
            end
        end
    end
    return nil, nil
end

local function applyImmuneHeadAnchor(targetModel, targetRoot)
    local character = LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetRoot then return end

    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end

    for _, descendant in ipairs(targetModel:GetDescendants()) do
        if descendant:IsA("TouchTransmitter") or descendant.Name == "TouchInterest" then
            descendant:Destroy()
        end
    end

    local headPart = targetModel:FindFirstChild("Head") or targetRoot
    local absoluteTopPosition = headPart.Position + Vector3.new(0, 5, 0)
    hrp.CFrame = CFrame.new(absoluteTopPosition, headPart.Position)
end

